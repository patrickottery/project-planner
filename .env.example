# One repo, two copies — the checkout's .env decides which it is.
APP_ENV=                  # dev | prod   (unset = dev: shows the DEV banner and allows the dev bypass)
# Pin the project name: dev (~/code) and prod (~/docker) share a directory name.
COMPOSE_PROJECT_NAME=     # project-planner-dev | project-planner
CONTAINER_NAME=           # same as COMPOSE_PROJECT_NAME
BUILD_TARGET=             # dev | prod
APP_PORT=                 # 4002 | 3002
BIND_IP=127.0.0.1         # 0.0.0.0 only if the app authenticates every route AND a LAN client needs it — say which
APPDATA_PATH=             # /home/patrick/docker/appdata/<COMPOSE_PROJECT_NAME>   (absolute)
DATA_PATH=/data/app.db
UPLOADS_PATH=/data/uploads
MAX_UPLOAD_MB=10
FLASK_DEBUG=              # dev only, and only briefly: 1 enables the Werkzeug debugger (RCE for anyone who can reach the port)

# Cloudflare Access (prod). Every request except /health must carry a valid
# Cf-Access-Jwt-Assertion for OWNER_EMAIL. AUD = the Access application covering the hostname.
CF_ACCESS_AUD=
CF_ACCESS_TEAM_DOMAIN=    # e.g. yourteam.cloudflareaccess.com
OWNER_EMAIL=              # comma-separated allowlist
# Dev bypass: used ONLY when CF_ACCESS_AUD is blank AND APP_ENV=dev. Any other
# combination with a blank AUD fails closed (every request 403).
DEV_AUTH_EMAIL=           # dev: e.g. dev@localhost | prod: leave blank
